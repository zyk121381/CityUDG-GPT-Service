# 学号密码（自动登录用，留空则只能用固定 token）
CITYU_ACCOUNT=
CITYU_PASSWORD=

# 固定 token（auth.mode = token 时用；或密码登录失败时兜底）
GPT_TOKEN=

# 账号标识：密码登录成功后会自动写进 data/token.json，一般不用手填。
# 只有纯 token 模式才需要，user_id 就是学校系统里的 StaffStuId。
GPT_USER_ID=
GPT_ACCOUNT_ID=

# Web 反代 / OpenAI 接口的访问密码（留空 = 不校验，只建议本机监听时留空）
PROXY_PASSWORD=
OPENAI_API_KEY=
